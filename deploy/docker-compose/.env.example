# Copy to .env (git-ignored) and fill in. docker compose refuses to start while a
# required value is missing. Generate secrets, e.g.:  openssl rand -base64 48
#
# Generate a throwaway TLS keystore for local use (never commit it). Use the keytool
# of the runtime image so the keystore format matches its JDK:
#   docker run --rm -u "$(id -u)" -v "$PWD:/w" tomcat:9.0.48-jdk11-adoptopenjdk-hotspot \
#     keytool -genkeypair -alias digitalbank -keyalg RSA -keysize 2048 -validity 365 \
#     -storetype PKCS12 -keystore /w/digisic.p12 -dname "CN=localhost"

# JWT signing keys (>= 32 bytes each; the services refuse to start without them)
BANK_JWT_SECRET=
CREDIT_JWT_SECRET=

# API admin bootstrap passwords (CREDIT_ADMIN_PASSWORD is also used by bank -> credit)
BANK_ADMIN_PASSWORD=
CREDIT_ADMIN_PASSWORD=

# Optional: password for the jsmith/nsmith sample users (random when empty)
BANK_SAMPLE_PASSWORD=

# TLS keystore mounted into both services at /usr/local/tomcat/conf/digisic.p12
KEYSTORE_FILE=./digisic.p12
KEYSTORE_PASSWORD=

# Database (not used by the H2 compose file)
DB_ROOT_PASSWORD=
DB_APP_PASSWORD=

# Artemis broker
ARTEMIS_USER=
ARTEMIS_PASSWORD=

# Optional: Open Banking consumer key
OBP_CONSUMER_KEY=
