<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>io.digisic</groupId>
	<artifactId>digitalbank-gen-one</artifactId>
	<version>2.1.0</version>
	<packaging>pom</packaging>
	<name>Digital Bank (Generation One)</name>
	<description>Digital Bank Demo Application</description>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.18</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!--
		EM-140 interim hardening: Spring Boot 2.7 is the last Java 8 compatible line.
		The overrides below move libraries managed by Boot 2.7.18 to their latest
		Java 8 compatible patch releases. Full fix: Java 21 / Boot 3 migration.
	-->
	<properties>
		<tomcat.version>9.0.123</tomcat.version>
		<spring-framework.version>5.3.39</spring-framework.version>
		<spring-security.version>5.8.16</spring-security.version>
		<snakeyaml.version>2.0</snakeyaml.version>
		<logback.version>1.2.13</logback.version>
		<jackson-bom.version>2.21.8</jackson-bom.version>
		<netty.version>4.1.139.Final</netty.version>
		<thymeleaf.version>3.1.5.RELEASE</thymeleaf.version>
		<postgresql.version>42.7.14</postgresql.version>
		<mysql.version>8.4.0</mysql.version>
		<jjwt.version>0.12.6</jjwt.version>
		<springdoc.version>1.8.0</springdoc.version>
		<dependency-check.version>12.2.2</dependency-check.version>
		<dependency-check.failBuildOnCVSS>9</dependency-check.failBuildOnCVSS>
	</properties>

	<modules>
		<module>bank</module>
		<module>credit</module>
		<module>test</module>
	</modules>

	<profiles>
		<!-- Software composition analysis: mvn -Powasp verify (fails on CVSS >= 9, i.e. Critical) -->
		<profile>
			<id>owasp</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
						<version>${dependency-check.version}</version>
						<configuration>
							<failBuildOnCVSS>${dependency-check.failBuildOnCVSS}</failBuildOnCVSS>
							<skipTestScope>true</skipTestScope>
							<formats>
								<format>HTML</format>
								<format>JSON</format>
							</formats>
							<nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
							<ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>check</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>